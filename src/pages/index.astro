---
import { Image } from 'astro:assets';
import Base from '../components/layouts/Base.astro';
import image01 from '../assets/images/image-01.jpg';
import { EVENT } from '../config/event.js';
---
<Base title="The Great Pumpkin Chase">
  <main class="page-shell">
    <section class="hero" data-hero>
      <Image src={image01} alt="Friends enjoying the Great Pumpkin Chase at night" class="hero-image" />
      <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-two" aria-hidden="true"></div>
      <div class="fireflies" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="hero-content" data-reveal>
        <div>
          <p class="hero-kicker"><span>✦</span> Charlottesville's fall adventure</p>
          <h1 class="display-title">The Great<br />Pumpkin Chase</h1>
          <p class="hero-lead">A city-wide night of riddles, clues, puzzles, challenges, chili, and unforgettable memories for teens and their friends.</p>
          <div class="hero-actions">
            <a href="/register" class="btn btn-arrow">Register now</a>
            <div class="event-chip"><span>●</span> {EVENT.dateLabel} &nbsp;·&nbsp; {EVENT.timeLabel}</div>
          </div>
        </div>
      </div>
    </section>

    <div class="info-strip container">
      <div class="info-grid">
        <article class="info-card"><div class="info-icon">✦</div><h3>Who it’s for</h3><p>Middle and high school students, grades 6–12, plus their friends.</p></article>
        <article class="info-card"><div class="info-icon">⌖</div><h3>Where we meet</h3><p>{EVENT.locationName}<br />{EVENT.locationAddress}</p></article>
        <article class="info-card"><div class="info-icon">◷</div><h3>When to arrive</h3><p>{EVENT.dateLabel}<br />Dinner starts at {EVENT.startTimeLabel} sharp.</p></article>
      </div>
    </div>

    <section class="section" id="details">
      <div class="container story-grid">
        <div data-reveal><h2 class="section-title">Solve the mysteries.<br />Make the memories.</h2><p class="section-copy">Gather your crew and explore Charlottesville, following clues, cracking puzzles, and taking on wild challenges as the night's mysteries unfold. We take care of the details—so you can focus on the fun.</p><ul class="story-list"><li>Chili dinner and late-night snacks included</li><li>Epic challenges at mystery waypoints</li><li>Prizes, music, and plenty of surprises</li><li>Adult-supervised from start to finish</li></ul></div>
        <div class="video-frame" data-reveal><iframe src="https://player.vimeo.com/video/878885644" title="Great Pumpkin Chase highlight reel" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>
      </div>
    </section>

    <section class="details">
      <div class="container section details-grid">
        <div data-reveal><h2 class="section-title">One big night,<br />all mapped out.</h2><p class="details-copy">We begin and end together at {EVENT.locationName}. In between, teams fan out across Charlottesville for an evening of discovery.</p></div>
        <div class="timeline-card" data-reveal><ol class="timeline"><li><strong>{EVENT.startTimeLabel}</strong>Chili dinner &amp; team check-in</li><li><strong>6:45pm</strong>The adventure begins</li><li><strong>9:15pm</strong>Teams return for snacks</li><li><strong>9:30pm</strong>Message, videos &amp; prizes</li><li><strong>{EVENT.endTimeLabel}</strong>Event concludes</li></ol></div>
      </div>
    </section>

    <section class="cta">
      <div class="container" data-reveal><h2 class="section-title">Ready to solve?</h2><p>Make a team with your friends, or come ready to meet some new ones. Registration is your first step toward a night of riddles, clues, and unforgettable fun.</p><a href="/register" class="btn btn-arrow">Register now</a></div>
    </section>
  </main>
</Base>
