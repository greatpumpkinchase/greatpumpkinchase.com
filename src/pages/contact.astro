---
import Base from '../components/layouts/Base.astro';
import CanonicalUrl from '../components/utilities/CanonicalUrl.astro';
---
<Base title="Contact | The Great Pumpkin Chase">
    <CanonicalUrl slot="head" page="contact" />
    <main>
        <section class="page-hero"><div class="container"><p class="eyebrow">We’re here to help</p><h1>Get in touch.</h1><p>Questions about the chase, registration, or bringing a group? We’ll have a way to send us a note soon.</p></div></section>
        <section class="page-main"><div class="container"><div class="form-card contact-coming-soon"><p class="eyebrow">Check back soon</p><h2>Contact form coming soon.</h2><p>We’re putting the finishing touches on our new contact form.</p></div><div class="contact-aside"><strong>Planning ahead?</strong> Take a look at our <a class="text-link" href="/parents">parent information</a> for event details, safety information, and more.</div></div></section>
    </main>
</Base>
