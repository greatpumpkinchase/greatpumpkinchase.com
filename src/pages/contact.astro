---
import Base from '../components/layouts/Base.astro';
import CanonicalUrl from '../components/utilities/CanonicalUrl.astro';
import ContactForm from '../partials/ContactForm.astro';
---
<Base title="Contact | The Great Pumpkin Chase">
    <CanonicalUrl slot="head" page="contact" />
    <main>
        <section class="page-hero"><div class="container"><p class="eyebrow">We’re here to help</p><h1>Get in touch.</h1><p>Questions about the event, registration, or bringing a group? Send us a note and we’ll get back to you soon.</p></div></section>
        <section class="page-main"><div class="container"><ContactForm /><div class="contact-aside"><strong>Planning ahead?</strong> Take a look at our <a class="text-link" href="/parents">parent information</a> for event details, safety information, and more.</div></div></section>
    </main>
</Base>
