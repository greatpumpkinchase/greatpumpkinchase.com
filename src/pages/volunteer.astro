---
import Base from '../components/layouts/Base.astro';
import CanonicalUrl from '../components/utilities/CanonicalUrl.astro';

const teams = [
    ['Prayer Team', 'Pray for a safe, joyful event and for every student who takes part.'],
    ['Refreshments & Decor', 'Create a welcoming space with food, drinks, and all the fall-night details.'],
    ['Driver Team', 'Chaperone a team as they solve riddles and travel through the adventure. Vehicle and age requirements apply.'],
    ['Waypoint Sentinel', 'Run clues and document challenges at one of our mystery locations.'],
    ['Setup Crew', 'Arrive early to help bring the food, décor, and event details together.'],
    ['Clean-up Crew', 'Stay after the celebration to help make the final reset easy.'],
    ['Scoring Team', 'Keep the points organized and help make the prize-giving magic happen.'],
    ['Clue Call Center', 'Be available by phone to offer a helpful nudge to brave adventurers.'],
];
---
<Base title="Volunteer | The Great Pumpkin Chase">
    <CanonicalUrl slot="head" page="volunteer" />
    <main>
        <section class="page-hero"><div class="container"><p class="eyebrow">Make the magic happen</p><h1>Join the volunteer crew.</h1><p>Your time and care make a safe, joy-filled night of riddles, clues, and challenges possible for every student.</p></div></section>
        <section class="page-main"><div class="container"><div class="volunteer-intro"><p class="eyebrow">There’s a place for you</p><h2 class="section-title">Many hands. One memorable night.</h2><p class="section-copy" style="margin-inline:auto">Whether you’re behind the scenes or right in the middle of the action, your help is an important part of the Great Pumpkin Chase.</p><p style="margin-top:28px"><a href="/volunteer/register" class="btn btn-arrow">Volunteer sign up</a></p></div><div class="serve-grid">{teams.map(([title, copy]) => <article class="serve-card"><h3>{title}</h3><p>{copy}</p></article>)}</div><div class="help-box"><p><strong>Not sure where you’d fit best?</strong><br />We’d love to talk it through. Reach out through our <a class="text-link" href="/contact">contact form</a>.</p></div></div></section>
    </main>
</Base>
