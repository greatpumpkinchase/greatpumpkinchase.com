---
import Base from '../components/layouts/Base.astro';
import { EVENT } from '../config/event.js';
import { getClosesAt, getOpensAt, getPreviewStatus, getRegistrationStatus } from '../js/isRegistrationOpen.js';

// The page is statically built, so this status is only the initial paint and the
// no-JS fallback. The inline script below re-decides on every page load from the
// visitor's clock, which is what lets open/close happen without a redeploy.
const previewStatus = getPreviewStatus();
const registrationStatus = getRegistrationStatus();
const opensAt = getOpensAt();
const closesAt = getClosesAt();
const opensOn = opensAt.format('MMMM D, YYYY');
---
<Base title="Register | The Great Pumpkin Chase">
    <main class="registration"><div class="container">
        <div
            class="registration-status"
            data-registration-status
            data-opens-at={String(opensAt.valueOf())}
            data-closes-at={String(closesAt.valueOf())}
            data-preview-pinned={previewStatus ?? undefined}
            aria-live="polite"
        >
            <div class="closed-card registration-status-card" data-status-card="open" hidden={registrationStatus !== 'open'}>
                <p class="eyebrow">Registration is open</p>
                <h1>Let’s get your team ready.</h1>
                <p>Complete your registration on our registration site, then gather your crew for the Great Pumpkin Chase on {EVENT.dateLabel}.</p>
                <a href={EVENT.registrationUrl} class="btn btn-arrow" style="margin-top:20px">Register now</a>
                <p class="registration-help">You’ll continue to app.greatpumpkinchase.com to complete your registration.</p>
            </div>

            <div class="closed-card registration-status-card" data-status-card="upcoming" hidden={registrationStatus !== 'upcoming'}>
                <p class="eyebrow">Save the date</p>
                <h1>Registration opens soon.</h1>
                <p>Online registration opens {opensOn}. Check back here then to register your student for the Great Pumpkin Chase.</p>
                <div class="registration-countdown">
                    <p class="countdown-label">Registration opens in</p>
                    <div class="countdown-units" aria-hidden="true">
                        <div class="countdown-unit"><strong data-countdown-days>--</strong><span>Days</span></div>
                        <div class="countdown-unit"><strong data-countdown-hours>--</strong><span>Hours</span></div>
                        <div class="countdown-unit"><strong data-countdown-minutes>--</strong><span>Minutes</span></div>
                        <div class="countdown-unit"><strong data-countdown-seconds>--</strong><span>Seconds</span></div>
                    </div>
                    <p class="sr-only" data-countdown-summary>{`Registration opens on ${opensOn}.`}</p>
                </div>
                <a href="/parents" class="text-link">Read parent information</a>
            </div>

            <div class="closed-card registration-status-card" data-status-card="closed" hidden={registrationStatus !== 'closed'}>
                <h1>Registration is closed.</h1>
                <p>Thanks for your interest in the Great Pumpkin Chase. Please check back later for updates about our next adventure.</p>
                <a href="/parents" class="text-link">Read parent information</a>
            </div>
        </div>
    </div></main>

    <script is:inline>
        document.querySelectorAll('[data-registration-status]').forEach((root) => {
            // A pinned local preview forces the status; the countdown still ticks.
            const pinnedStatus = root.dataset.previewPinned || null;

            const opensAt = Number(root.dataset.opensAt);
            const closesAt = Number(root.dataset.closesAt);
            if (!Number.isFinite(opensAt) || !Number.isFinite(closesAt)) return;

            const cards = {};
            root.querySelectorAll('[data-status-card]').forEach((card) => {
                cards[card.dataset.statusCard] = card;
            });

            const countdown = {
                days: root.querySelector('[data-countdown-days]'),
                hours: root.querySelector('[data-countdown-hours]'),
                minutes: root.querySelector('[data-countdown-minutes]'),
                seconds: root.querySelector('[data-countdown-seconds]'),
                summary: root.querySelector('[data-countdown-summary]'),
            };

            const pad = (value) => String(value).padStart(2, '0');
            const statusAt = (now) => {
                if (now < opensAt) return 'upcoming';
                if (now >= closesAt) return 'closed';
                return 'open';
            };

            let shownStatus = null;
            let shownDays = null;

            const render = () => {
                const now = Date.now();
                const status = pinnedStatus || statusAt(now);

                if (status !== shownStatus) {
                    Object.keys(cards).forEach((key) => {
                        cards[key].hidden = key !== status;
                    });
                    shownStatus = status;
                }

                if (status !== 'upcoming') return;

                const totalSeconds = Math.floor(Math.max(0, opensAt - now) / 1000);
                const days = Math.floor(totalSeconds / 86400);

                if (countdown.days) countdown.days.textContent = String(days);
                if (countdown.hours) countdown.hours.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
                if (countdown.minutes) countdown.minutes.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
                if (countdown.seconds) countdown.seconds.textContent = pad(totalSeconds % 60);

                // Announce only when the day count changes, so screen readers
                // aren't read a new countdown every second.
                if (countdown.summary && days !== shownDays) {
                    countdown.summary.textContent = days === 1
                        ? 'Registration opens in 1 day.'
                        : `Registration opens in ${days} days.`;
                    shownDays = days;
                }
            };

            render();
            window.setInterval(render, 1000);
            // A backgrounded tab throttles timers; re-check the moment it returns.
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) render();
            });
        });
    </script>
</Base>
