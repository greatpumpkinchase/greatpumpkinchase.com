<form method="POST" netlify>
    <div class="form-grid">
        <div class="field"><label for="name">Name</label><input type="text" name="name" id="name" autocomplete="name" required /></div>
        <div class="field"><label for="email">Email address</label><input type="email" name="email" id="email" autocomplete="email" required /></div>
        <div class="field field-full"><label for="message">How can we help?</label><textarea name="message" id="message" rows="8" required></textarea></div>
    </div>
    <button class="btn btn-arrow" style="margin-top:25px" type="submit">Send message</button>
</form>
